<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProbeScenario Condition="'$(ProbeScenario)' == ''">Chat</ProbeScenario>
    <DefineConstants>$(DefineConstants);PROBE_$(ProbeScenario)</DefineConstants>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(SdkPackageVersion)' == ''">
    <ProjectReference Include="../../libs/Anthropic/Anthropic.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SdkPackageVersion)' != ''">
    <PackageReference Include="tryAGI.Anthropic" Version="$(SdkPackageVersion)" />
  </ItemGroup>
</Project>
